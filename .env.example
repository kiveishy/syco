# Copy to .env and adjust. All settings are optional; see rag/config.py for the full list.

# LLM backend: "cli" (Claude Code CLI with your claude.ai login, personal prototyping only)
#              "api" (Anthropic API key - required for anything other people use)
SYCO_LLM_BACKEND=cli
SYCO_LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...        # needed only when SYCO_LLM_BACKEND=api

# Path to the claude executable if it is not on PATH (auto-detected from the VS Code extension otherwise)
# SYCO_CLAUDE_CLI=

# Retrieval
# SYCO_TOP_K=6
# SYCO_CANDIDATES=30
# SYCO_USE_RERANKER=1
# SYCO_DEVICE=cpu                     # or cuda

# Chunking
# SYCO_CHILD_TARGET_TOKENS=320
# SYCO_PARENT_MAX_TOKENS=1800
